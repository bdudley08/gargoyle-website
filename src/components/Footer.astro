---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="grid cols-4">
      <div>
        <a href="/" class="brand" aria-label="Gargoyle Exterior Cleaning — home">
          <span class="brand-mark" aria-hidden="true">
            <img src="/gargoyle-mark.png" alt="" width="480" height="480" />
          </span>
          GARGOYLE
        </a>
        <p class="muted" style="margin-top: 0.9rem; font-size: 0.9rem; max-width: 16em;">
          {SITE.tagline}.
        </p>
      </div>
      <div>
        <h2>Services</h2>
        <ul>
          <li><a href="/services#gutters">Gutter cleaning</a></li>
          <li><a href="/services#roof">Roof cleaning &amp; moss removal</a></li>
          <li><a href="/services#pressure-washing">Pressure washing</a></li>
          <li><a href="/services#windows">Window cleaning</a></li>
          <li><a href="/services#solar">Solar panel cleaning</a></li>
        </ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>
          <li><a href="/gem-club">GEM Club</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Get a quote</a></li>
        </ul>
      </div>
      <div>
        <h2>Contact</h2>
        <ul>
          <li><a href={SITE.phoneHref}>{SITE.phone}</a></li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li class="muted">{SITE.hours}</li>
          <li>
            <a
              href="https://www.facebook.com/profile.php?id=61591712560698"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Gargoyle Exterior Cleaning on Facebook"
              class="social-link"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {SITE.name} · Bellevue, WA</span>
      <span>Owner-operated · Licensed · Bonded · Insured</span>
      <span><a href="/privacy">Privacy policy</a></span>
    </div>
  </div>
</footer>

<style>
  .social-link {
    display: inline-flex;
    align-items: center;
  }
</style>
