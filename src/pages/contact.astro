---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
---

<Base
  title="Get a Free Quote — Gargoyle Exterior Cleaning, Bellevue & the Eastside"
  description="Request a free quote for gutter cleaning, window cleaning, roof moss treatment, pressure washing, or solar panel cleaning in Bellevue and the Eastside, plus Seattle. Firm pricing, usually the same day."
>
  <section class="section section--flush">
    <div class="container">
      <p class="kicker">Contact</p>
      <h1 class="display">Get a free quote.</h1>
      <p class="lede">
        A few details about your home is all it takes. Quotes are firm, free,
        and usually back to you the same day.
      </p>
    </div>
  </section>

  <section class="section" aria-label="Contact details and quote form">
    <div class="container">
      <div class="grid split">
        <div>
          <dl class="contact-list">
            <div>
              <dt class="kicker" style="margin-bottom: 0.35rem;">Phone</dt>
              <dd><a href={SITE.phoneHref}>{SITE.phone}</a></dd>
            </div>
            <div>
              <dt class="kicker" style="margin-bottom: 0.35rem;">Email</dt>
              <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
            </div>
            <div>
              <dt class="kicker" style="margin-bottom: 0.35rem;">Hours</dt>
              <dd>{SITE.hours}</dd>
            </div>
            <div>
              <dt class="kicker" style="margin-bottom: 0.35rem;">Service area</dt>
              <dd>{SITE.areaServed.join(' · ')}</dd>
            </div>
            <div>
              <dt class="kicker" style="margin-bottom: 0.35rem;">Service discount</dt>
              <dd>10% off your first service</dd>
              <p class="muted" style="margin-top: 0.5rem; font-size: 0.9rem; max-width: 26em;">
                For active duty, veterans, and first responders. Just mention it
                when you get in touch — Gargoyle is veteran-owned, and we look
                after our own.
              </p>
            </div>
          </dl>
          <p class="muted" style="margin-top: 2rem; max-width: 26em;">
            Texting a couple of photos of your gutters or roof to the number
            above is the fastest way to get an accurate quote.
          </p>
        </div>

        <div class="quote-form">
          {/* Jobber work request form. The script must stay `is:inline` —
              without it Astro bundles the script and strips the custom
              clienthub_id / form_url attributes, which silently breaks the
              embed. Managed in Jobber under Settings → Work Request form. */}
          <div id="9ca0bb84-b482-474f-824a-4809cd551054-5066835"></div>
          <link
            rel="stylesheet"
            href="https://d3ey4dbjkt2f6s.cloudfront.net/assets/external/work_request_embed.css"
            media="screen"
          />
          <script
            is:inline
            src="https://d3ey4dbjkt2f6s.cloudfront.net/assets/static_link/work_request_embed_snippet.js"
            clienthub_id="9ca0bb84-b482-474f-824a-4809cd551054-5066835"
            form_url="https://clienthub.getjobber.com/client_hubs/9ca0bb84-b482-474f-824a-4809cd551054/public/work_request/embedded_work_request_form?form_id=5066835"
          ></script>
          <p class="muted" style="margin-top: 1rem; font-size: 0.85rem;">
            We reply within one business day — usually much faster.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-list {
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }

  .contact-list dd {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .contact-list dd a {
    text-decoration: none;
  }

  .contact-list dd a:hover {
    text-decoration: underline;
  }

  /* Keep the embedded Jobber iframe inside its grid column on narrow screens. */
  .quote-form {
    min-width: 0;
  }

  .quote-form :global(iframe) {
    max-width: 100%;
  }
</style>
